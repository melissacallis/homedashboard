# Copy this file to .env and fill in what you use. Never commit .env.

# --- Google Calendar (required for the Today panel) ---
# From Google Cloud Console > APIs & Services > Credentials (see README step 2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only change this if the dashboard isn't at http://localhost:3000
# GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback

# --- Ugenda (optional: bills and medications) ---
# Leave blank to read bills and medications from Google Calendar instead.
# UGENDA_URL=https://ugenda.me
# UGENDA_TOKEN=

# --- Weather (optional) ---
# Your latitude and longitude, e.g. from Google Maps (right-click a spot)
# WEATHER_LAT=
# WEATHER_LON=
# WEATHER_UNIT=fahrenheit

# --- Markets (optional) ---
# Up to 8. Plain tickers (AAPL) or index codes: ^SPX = S&P 500, ^NDQ = Nasdaq, ^DJI = Dow
# STOCK_SYMBOLS=^SPX,^NDQ,AAPL,MSFT

# --- News (optional) ---
# Leave blank for top US stories, or set a topic, e.g. "technology" or your city
# NEWS_TOPIC=

# --- Only needed when the dashboard is on the internet instead of the Pi ---
# DASHBOARD_PASSWORD=
# HOST=0.0.0.0
